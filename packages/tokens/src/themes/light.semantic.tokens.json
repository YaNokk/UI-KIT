    }
  },
  "status": {
    "success": {
      "background": { "$type": "color", "$value": "{color.green.100}" },
      "foreground": { "$type": "color", "$value": "{color.green.900}" },
      "border": { "$type": "color", "$value": "{color.green.300}" }
