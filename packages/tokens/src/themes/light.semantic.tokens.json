  "navigation": {
    "item": {
      "background": { "$type": "color", "$value": "transparent" },
      "backgroundHover": { "$type": "color", "$value": "{background.subtle}" },
      "backgroundActive": { "$type": "color", "$value": "{brand.accentSoft}" },
      "text": { "$type": "color", "$value": "{text.secondary}" },
