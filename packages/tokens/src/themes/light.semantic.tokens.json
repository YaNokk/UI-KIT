    "danger": {
      "background": { "$type": "color", "$value": "{color.red.100}" },
      "foreground": { "$type": "color", "$value": "{color.red.900}" },
      "border": { "$type": "color", "$value": "{color.red.300}" }
    },
    "info": {
      "background": { "$type": "color", "$value": "{color.blue.100}" },
      "foreground": { "$type": "color", "$value": "{color.blue.700}" },
      "border": { "$type": "color", "$value": "{brand.accentBorder}" }
    }
