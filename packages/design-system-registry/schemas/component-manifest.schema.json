{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app.local/schemas/component-manifest.schema.json",
  "title": "Generated component manifest",
  "type": "object",
  "description": "Generated from TypeScript and Storybook; never maintained manually.",
  "properties": {
    "generatedAt": { "type": "string", "format": "date-time" },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "importPath", "stories"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "importPath": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "props": { "type": "object" },
          "stories": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": ["generatedAt", "components"],
  "additionalProperties": false
}

