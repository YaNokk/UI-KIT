{
  "name": "design-system-foundation",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run tokens:generate && npm run build --workspace=@mypoint/tokens && npm run build --workspace=@mypoint/ui && npm run build --workspace=@mypoint/retail-ui",
    "tokens:generate": "node packages/tokens/scripts/generate.mjs",
    "tokens:check": "node packages/tokens/scripts/generate.mjs --check && npm run responsive:check",
    "responsive:check": "node scripts/check-responsive-foundation.mjs",
    "lint": "eslint . && npm run typography:check && npm run motion:check",
    "typography:check": "node scripts/check-single-line-control-typography.mjs",
    "motion:check": "node scripts/check-motion-foundation.mjs",
    "test": "vitest run packages",
    "test:storybook": "vitest --config vitest.storybook.config.ts --run",
    "workspace-test-resolution:check": "node scripts/verify-vitest-workspace-resolution.mjs",
    "choice-controls:storybook:collection-check": "node scripts/check-choice-control-storybook-collection.mjs",
    "choice-controls:storybook:report": "node scripts/run-choice-control-storybook-report.mjs",
    "choice-controls:storybook:execution-check": "node scripts/check-choice-control-storybook-execution.mjs",
    "choice-controls:storybook:execution-test": "node scripts/test-choice-control-storybook-execution.mjs",
    "choice-controls:storybook:verify": "npm run choice-controls:storybook:collection-check && npm run choice-controls:storybook:report && npm run choice-controls:storybook:execution-check",
    "choice-controls:state-capture:test": "vitest --config vitest.choice-controls-state.config.ts --run",
    "select:state-capture:test": "vitest --config vitest.select-state.config.ts --run",
    "floating-trigger:verify": "npm run test:storybook -- packages/ui/src/internal/select/SharedFloatingTriggerBrowserRegression.stories.tsx",
    "select-multiselect:verify": "npm run select:state-capture:test && npm run floating-trigger:verify && npm run test:storybook -- packages/ui/src/internal/select/SelectMultiSelectBrowserRegression.stories.tsx",
    "international-phone-input:verify": "vitest run packages/ui/src/internal/phone packages/ui/src/internal/country-flags packages/ui/src/InternationalPhoneInput && npm run floating-trigger:verify && npm run test:storybook -- packages/ui/src/InternationalPhoneInput/InternationalPhoneInputBrowserRegression.stories.tsx",
    "textarea:forced-colors:verify": "vitest --config vitest.textarea-forced-colors.config.ts --run",
    "textarea:verify": "vitest run packages/ui/src/Textarea && npm run test:storybook -- packages/ui/src/Textarea/TextareaBrowserRegression.stories.tsx && npm run textarea:forced-colors:verify",
    "choice-controls:verify": "npm run choice-controls:storybook:verify && npm run choice-controls:storybook:execution-test && npm run choice-controls:state-capture:test",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "pack:check": "node scripts/verify-package.mjs",
    "consumer:test": "node scripts/test-consumer.mjs",
    "tree-shaking:test": "node scripts/verify-tree-shaking.mjs",
    "flag-bundle:measure": "node scripts/measure-international-phone-flag-bundle.mjs",
    "flags:generate": "node scripts/generate-country-flag-sprite.mjs",
    "registry:configure": "node scripts/configure-npm-registry.mjs",
    "publish:local": "node scripts/publish-local.mjs",
    "release:check": "node scripts/verify-release-version.mjs",
    "storybook": "storybook dev -p 6006 -c apps/storybook/.storybook",
    "storybook:mcp:check": "node scripts/verify-storybook-mcp.mjs",
    "build-storybook": "storybook build -c apps/storybook/.storybook -o storybook-static"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "^4.0.0",
    "@eslint/js": "^9.32.0",
    "@storybook/addon-a11y": "^9.1.0",
    "@storybook/addon-docs": "^9.1.0",
    "@storybook/addon-mcp": "^0.0.6",
    "@storybook/addon-vitest": "^9.1.20",
    "@storybook/react-vite": "^9.1.0",
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.16.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitest/browser": "^3.2.7",
    "axe-core": "^4.10.3",
    "country-flag-icons": "^1.6.20",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "markdown-to-jsx": "^7.7.17",
    "playwright": "^1.62.1",
    "postcss": "^8.5.24",
    "postcss-custom-media": "^12.0.1",
    "storybook": "^9.1.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.5",
    "vitest": "^3.2.4"
  }
}
