{
  "name": "design-system-foundation",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "tokens:generate": "node packages/tokens/scripts/generate.mjs",
    "tokens:check": "node packages/tokens/scripts/generate.mjs --check",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "storybook": "storybook dev -p 6006 -c apps/storybook/.storybook",
    "build-storybook": "storybook build -c apps/storybook/.storybook -o storybook-static"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@storybook/addon-a11y": "^9.1.0",
    "@storybook/addon-docs": "^9.1.0",
    "@storybook/addon-mcp": "^0.0.6",
    "@storybook/react-vite": "^9.1.0",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^22.16.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "storybook": "^9.1.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.5",
    "vitest": "^3.2.4"
  }
}
