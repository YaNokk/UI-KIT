# GitLab host without protocol.
GITLAB_HOST=gitlab.example.com

# Numeric GitLab project ID containing the package registry.
GITLAB_PROJECT_ID=12345

# npm package scope.
NPM_SCOPE=@mypoint

# Local/manual publishing token with write_package_registry.
NPM_PUBLISH_TOKEN=

# Read-only token for private package installation.
NPM_READ_TOKEN=

# Optional group ID for group-level consumer registry access.
GITLAB_GROUP_ID=
